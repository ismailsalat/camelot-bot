# ---------------------------------------------------------------------------
# Camelot Bot — environment
# Copy this file to `.env` and fill it in. NEVER commit your real .env file.
# ---------------------------------------------------------------------------

# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# Application ID from the same app page -> General Information -> Application ID
DISCORD_CLIENT_ID=

# Optional: a single server ID. If set, slash commands register instantly to
# that server only (great for development). Leave empty to register globally
# (can take up to an hour to appear the first time).
DEV_GUILD_ID=

# Where the SQLite file lives.
# Local default: ./data/camelot.sqlite
# On Railway, attach a Volume mounted at /data and set this to /data/camelot.sqlite
DATABASE_PATH=./data/camelot.sqlite

# Prefix for the short text commands: !allies, !purge @someone.
# 1-3 symbols. Letters and digits are rejected, and so are / @ # < and `
# because Discord treats those specially. Leave empty for "!".
# Any server owner can override this for their own server in /settings.
COMMAND_PREFIX=!

# error | warn | info | debug
LOG_LEVEL=info

# Streaming: set through /settings → Streaming, or use the two values below.
# Keep DATABASE_PATH on a persistent Railway Volume mounted at /data.
# CAMELOT_STREAMER_TOKEN=
# CAMELOT_GUILD_ID=
# Optional stable AES key: 64 hex characters. Otherwise /data/streaming.key is created.
# STREAMING_SECRET_KEY=
# STREAMING_PORT=3334
# CAMELOT_PROVIDERS=hianime,animeparadise,anikoto,megaplay,anineko,allmanga,gogoanime,goyabu,animepahe,animekai,kickassanime
