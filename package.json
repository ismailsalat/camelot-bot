{
  "name": "camelot-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Camelot — a quiet, simple Discord bot for small friend servers.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "register": "tsx src/commands/register.ts",
    "register:prod": "node dist/commands/register.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/test/*.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.10"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
